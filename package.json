{
  "name": "zank",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --bun drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "bun --bun drizzle-kit push --config=drizzle.config.ts",
    "db:pull": "bun --bun drizzle-kit pull --config=drizzle.config.ts",
    "db:studio": "bun --bun drizzle-kit studio --config=drizzle.config.ts",
    "auth-db:generate": "bun --bun drizzle-kit generate --config=auth.drizzle.config.ts",
    "auth-db:migrate": "bun --bun drizzle-kit migrate --config=auth.drizzle.config.ts",
    "auth-db:push": "bun --bun drizzle-kit push --config=auth.drizzle.config.ts",
    "auth-db:pull": "bun --bun drizzle-kit pull --config=auth.drizzle.config.ts",
    "auth-db:studio": "bun --bun drizzle-kit studio --config=auth.drizzle.config.ts",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@libsql/client": "^0.17.2",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-devtools": "^0.10.1",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-query-devtools": "^5.96.1",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.16",
    "@tanstack/router-plugin": "^1.167.12",
    "better-auth": "^1.5.6",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "nitro": "npm:nitro-nightly@latest",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.3",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "web-vitals": "^5.2.0",
    "wrangler": "^4.79.0"
  }
}
